{
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "akash-shinge.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "index, follow" }]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "akash-shinge.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
